{
  "name": "mini-kraken-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "api:validate": "tsx src/scripts/validate-openapi.ts",
    "api:generate": "openapi-generator-cli generate -i ../openapi/openapi.yaml -g typescript-fetch -o src/api/generated --global-property models,supportingFiles=runtime.ts,modelDocs=false,modelTests=false --additional-properties=modelPropertyNaming=original,dateLibrary=string,importFileExtension=.js",
    "fake:device": "tsx src/tests/fake-bonjour-service.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.7",
    "bonjour-service": "^1.4.4",
    "fastify": "^5.12.8",
    "fastify-cli": "^8.0.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/node": "^26.6.6",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
